{
  "name": "skillet",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write \"src/**/*.{ts,tsx,md}\"",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "demo:gif": "node --env-file=.env scripts/capture/capture-demo.mjs",
    "postinstall": "prisma generate",
    "test": "vitest run"
  },
  "prisma": {
