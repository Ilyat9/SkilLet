# NextAuth (Auth.js v5)
AUTH_SECRET=сгенерируй-через-openssl-rand-base64-32
AUTH_GITHUB_ID=твой_github_oauth_app_id
AUTH_GITHUB_SECRET=твой_github_oauth_app_secret

# URL приложения
NEXTAUTH_URL=http://localhost:3000

# PostgreSQL (обязателен для Prisma).
# Пул соединений: приложение — долгоживущий Node-процесс (Docker/self-hosted,
# см. DEPLOYMENT.md), поэтому дефолтного пула Prisma достаточно. Явные лимиты
# нужны только для serverless-деплоя (Vercel): там каждый invocation изолирован,
# и без лимита быстро исчерпывается лимит соединений Postgres:
#   DATABASE_URL=postgresql://user:pass@host:5432/skillet?connection_limit=5&pool_timeout=10
#   - connection_limit=5 — максимум соединений на один инстанс/invocation;
#   - pool_timeout=10    — сколько секунд ждать свободное соединение из пула.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skillet

# AI-генерация деревьев (опционально; без ключа фича возвращает 503 с подсказкой)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Резервные модели через запятую (фолбэк при недоступности основной).
# Если не задано — встроенный список бесплатных моделей OpenRouter.
# Пример конфигурации через OpenRouter (бесплатные модели):
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_API_KEY=sk-or-v1-...
#   OPENAI_MODEL=z-ai/glm-5.2:free
# OPENAI_FALLBACK_MODELS=minimax/minimax-m3:free,google/gemma-4-31b-it:free

# Error tracking (опционально). Формат: https://<publicKey>@<host>/<projectId>.
# Без переменной трекинг ошибок отключён (логируются только в stdout).
SENTRY_DSN=
